---
import { about } from '../data/site';
---

<section class="section" id="about">
  <div class="section-head">
    <span class="section-num">02</span>
    <span class="section-title">About Me</span>
  </div>

  <div class="about-grid">
    <div class="about-main">
      <h2 class="display about-heading reveal">
        Building at the intersection of <em>Tech</em> &amp; <em>Design</em>.
      </h2>
      <p class="about-text reveal">
        Final year ISE student at RNSIT, Bangalore — building at the intersection of AI and
        design. Currently interning at <strong>Vertex Power Solutions</strong> as a Product
        Engineering Division intern.
      </p>
      <p class="about-text reveal">
        I've shipped 2 AI-powered projects using Python, Firebase and LLM APIs — focused on clean
        UX, fast iteration, and practical problem solving.
      </p>
      <div class="about-chips reveal">
        {about.chips.map((chip) => <span class="chip">{chip}</span>)}
      </div>
    </div>

    <aside class="about-aside">
      <div class="info-card reveal">
        <h3 class="info-card-title">Quick Info</h3>
        <dl>
          {
            about.quickInfo.map((row) => (
              <div class="info-row">
                <dt>{row.key}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="info-card reveal">
        <h3 class="info-card-title">Current Role</h3>
        <dl>
          {
            about.currentRole.map((row) => (
              <div class="info-row">
                <dt>{row.key}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </aside>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(260px, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .about-heading {
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    max-width: 16ch;
    margin-bottom: 2rem;
  }

  .about-text {
    max-width: 52ch;
    color: var(--ink-dim);
    font-size: 1.05rem;
    margin-bottom: 1.25rem;
  }

  .about-text strong {
    color: var(--ink);
    font-weight: 500;
  }

  .about-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .about-aside {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    border: 1px solid var(--line);
    background: var(--bg-raised);
    padding: 1.5rem;
  }

  .info-card-title {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.88rem;
  }

  .info-row:last-child {
    border-bottom: none;
  }

  .info-row dt {
    color: var(--ink-faint);
  }

  .info-row dd {
    text-align: right;
  }

  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
