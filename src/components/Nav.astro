---
import { navItems, socials } from '../data/site';
---

<header class="topbar">
  <a href="#hero" class="logo" aria-label="Home">
    <span class="logo-prompt">root@adithya</span><span class="logo-path">:~$</span><span
      class="logo-cmd">./portfolio</span
    >
  </a>
  <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu-overlay">
    <span class="menu-btn-label">Menu</span>
    <span class="menu-btn-lines" aria-hidden="true"><i></i><i></i></span>
  </button>
</header>

<nav class="menu-overlay" id="menu-overlay" aria-hidden="true">
  <ul class="menu-list">
    {
      navItems.map((item) => (
        <li>
          <a href={item.href} class="menu-link" data-menu-close>
            <span class="menu-num">{item.num}.</span>
            <span class="menu-label">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <div class="menu-footer">
    <a href={socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
    <a href={socials.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    <a href={socials.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
  </div>
</nav>

<div class="scroll-progress" aria-hidden="true"><i id="scroll-progress-bar"></i></div>

<div id="prog-pill" aria-hidden="true">
  <span class="pill-dot"></span>
  <span class="pill-bar-wrap"><i id="pill-bar"></i></span>
  <span id="pill-pct">0%</span>
  <span id="pill-section">Home</span>
</div>

<script>
  const btn = document.getElementById('menu-btn')!;
  const overlay = document.getElementById('menu-overlay')!;

  function setOpen(open: boolean) {
    btn.setAttribute('aria-expanded', String(open));
    overlay.setAttribute('aria-hidden', String(!open));
    overlay.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  }

  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  overlay.querySelectorAll('[data-menu-close]').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  const bar = document.getElementById('scroll-progress-bar')!;
  const pill = document.getElementById('prog-pill')!;
  const pillBar = document.getElementById('pill-bar')!;
  const pillPct = document.getElementById('pill-pct')!;
  const pillSection = document.getElementById('pill-section')!;

  const sectionLabels: Record<string, string> = {
    hero: 'Home',
    about: 'About',
    work: 'Work',
    skills: 'Skills',
    education: 'Education',
    more: 'More',
    contact: 'Contact',
  };
  const sections = Object.keys(sectionLabels)
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  // ── MENU label scrambles into the current section name ──
  const menuLabel = document.querySelector<HTMLElement>('.menu-btn-label')!;
  const GLITCH_SET = '@#%&!?$X*+=-~^<>';
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let currentLabel = 'Menu';
  let labelGlitching = false;

  function scrambleMenuLabel(target: string) {
    if (labelGlitching || target === currentLabel) return;
    currentLabel = target;

    if (reducedMotion) {
      menuLabel.textContent = target;
      menuLabel.classList.toggle('section-active', target !== 'Menu');
      return;
    }

    labelGlitching = true;
    menuLabel.classList.add('glitching');
    menuLabel.classList.remove('section-active');

    let iter = 0;
    const total = target.length * 2;
    const gi = setInterval(() => {
      menuLabel.textContent = target
        .split('')
        .map((char, i) => {
          if (i < Math.floor(iter / 4)) return char;
          return GLITCH_SET[Math.floor(Math.random() * GLITCH_SET.length)];
        })
        .join('');
      iter++;

      if (iter >= total) {
        clearInterval(gi);
        menuLabel.textContent = target;
        menuLabel.classList.remove('glitching');
        if (target !== 'Menu') menuLabel.classList.add('section-active');
        labelGlitching = false;
      }
    }, 18);
  }

  addEventListener(
    'scroll',
    () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      const pct = max > 0 ? (scrollY / max) * 100 : 0;
      bar.style.width = `${pct}%`;

      pillBar.style.width = `${pct}%`;
      pillPct.textContent = `${Math.round(pct)}%`;

      const probe = scrollY + innerHeight * 0.4;
      let current = sections[0];
      for (const sec of sections) {
        if (sec.offsetTop <= probe) current = sec;
      }
      if (current) pillSection.textContent = sectionLabels[current.id] ?? '';

      scrambleMenuLabel(
        scrollY > 80 && current ? (sectionLabels[current.id] ?? 'Menu') : 'Menu'
      );

      // hide near the page bottom so it never overlaps the footer
      const nearBottom = scrollY > max - 250;
      pill.classList.toggle('show', scrollY > innerHeight * 0.6 && !nearBottom);
    },
    { passive: true }
  );
</script>

<style>
  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1.1rem var(--gutter);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--glass);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
    transition: background 0.55s;
  }

  .logo {
    font-family: var(--mono);
    font-size: 0.85rem;
  }

  .logo-prompt {
    color: var(--accent);
  }
  .logo-path {
    color: var(--ink-dim);
  }
  .logo-cmd {
    color: var(--ink);
  }

  .menu-btn {
    font-family: var(--mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .menu-btn-label {
    display: inline-block;
    min-width: 9ch;
    text-align: right;
    transition: color 0.25s;
  }

  .menu-btn-label.section-active {
    color: var(--accent);
    text-shadow: 0 0 12px var(--accent-glow);
  }

  .menu-btn-label.glitching {
    color: var(--accent);
    text-shadow: 0 0 16px var(--accent-glow);
  }

  .menu-btn-lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 26px;
  }

  .menu-btn-lines i {
    height: 1px;
    background: var(--ink);
    transition: transform 0.35s;
  }

  .menu-btn[aria-expanded='true'] .menu-btn-lines i:first-child {
    transform: translateY(3px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .menu-btn-lines i:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--bg);
    padding: 0 var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s, visibility 0.4s;
  }

  .menu-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .menu-list {
    list-style: none;
  }

  /* links stagger in as the overlay opens */
  .menu-list li {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .menu-overlay.is-open .menu-list li {
    opacity: 1;
    transform: none;
  }

  .menu-overlay.is-open .menu-list li:nth-child(1) { transition-delay: 0.08s; }
  .menu-overlay.is-open .menu-list li:nth-child(2) { transition-delay: 0.14s; }
  .menu-overlay.is-open .menu-list li:nth-child(3) { transition-delay: 0.2s; }
  .menu-overlay.is-open .menu-list li:nth-child(4) { transition-delay: 0.26s; }
  .menu-overlay.is-open .menu-list li:nth-child(5) { transition-delay: 0.32s; }
  .menu-overlay.is-open .menu-list li:nth-child(6) { transition-delay: 0.38s; }
  .menu-overlay.is-open .menu-list li:nth-child(7) { transition-delay: 0.44s; }

  .menu-link {
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: clamp(2.2rem, 6.5vw, 4.5rem);
    line-height: 1.1;
    color: var(--ink-dim);
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 0.35rem 0;
    transition: color 0.25s, transform 0.25s;
  }

  .menu-link:hover {
    color: var(--ink);
    transform: translateX(0.5rem);
  }

  .menu-num {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--accent);
  }

  .menu-footer {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--ink-dim);
    display: flex;
    gap: 2rem;
    margin-top: 3rem;
  }

  .menu-footer a:hover {
    color: var(--accent);
  }

  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 110;
  }

  .scroll-progress i {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--accent);
  }

  #prog-pill {
    position: fixed;
    bottom: 1.4rem;
    left: 50%;
    transform: translateX(-50%) translateY(12px);
    z-index: 95;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.45rem 1.1rem 0.45rem 0.8rem;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 100px;
    backdrop-filter: blur(14px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s, transform 0.35s, background 0.55s;
  }

  #prog-pill.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .pill-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent-glow);
    animation: pill-blink 1.4s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes pill-blink {
    50% {
      opacity: 0.3;
    }
  }

  .pill-bar-wrap {
    width: 72px;
    height: 2px;
    background: var(--line-strong);
    border-radius: 2px;
    overflow: hidden;
  }

  #pill-bar {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent-glow);
    border-radius: 2px;
    transition: width 0.12s linear;
  }

  #pill-pct {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    color: var(--ink-dim);
    min-width: 2.5ch;
  }

  #pill-section {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding-left: 0.7rem;
    border-left: 1px solid var(--line);
  }

  @media (max-width: 768px) {
    #prog-pill {
      display: none;
    }
  }
</style>
