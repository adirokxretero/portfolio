---
import { contactInfo, site, socials } from '../data/site';
---

<section class="section" id="contact">
  <div class="section-head">
    <span class="section-num">07</span>
    <span class="section-title">Get In Touch</span>
  </div>

  <h2 class="contact-heading display reveal">
    LET'S<br /><em>TALK</em><span class="contact-dot">.</span>
  </h2>

  <div class="contact-grid">
    <div class="contact-main reveal">
      <a href={`mailto:${site.email}`} class="contact-email">{site.email}</a>
      <div class="contact-socials">
        <a href={socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn →</a>
        <a href={socials.github} target="_blank" rel="noopener noreferrer">GitHub →</a>
        <a href={socials.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp →</a>
      </div>
    </div>

    <dl class="contact-info reveal">
      {
        contactInfo.map((row) => (
          <div class="contact-row">
            <dt>{row.key}</dt>
            <dd>
              {row.href ? (
                <a
                  href={row.href}
                  target={row.href.startsWith('http') ? '_blank' : undefined}
                  rel="noopener noreferrer"
                >
                  {row.value}
                </a>
              ) : (
                row.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .contact-heading {
    font-size: clamp(4rem, 16vw, 13rem);
    text-transform: uppercase;
    margin-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }

  .contact-dot {
    color: var(--accent);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .contact-email {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.2rem, 2.6vw, 1.9rem);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.35rem;
    display: inline-block;
    transition: color 0.25s, border-color 0.25s;
  }

  .contact-email:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .contact-socials {
    font-family: var(--mono);
    font-size: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-top: 2rem;
  }

  .contact-socials a:hover {
    color: var(--accent);
  }

  .contact-info {
    border-top: 1px solid var(--line-strong);
  }

  .contact-row {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.88rem;
  }

  .contact-row dt {
    color: var(--ink-faint);
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.75rem;
  }

  .contact-row dd {
    text-align: right;
  }

  .contact-row a:hover {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
